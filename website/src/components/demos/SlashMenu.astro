---
import { CHAT_INPUT_MAX_WIDTH, WINDOW_HEIGHT_PX } from '../../lib/appLayout';
import { SLASH_MENU_ITEM, SLASH_MENU_SURFACE } from '../../lib/appUi';

// Mirrors `BUILTIN_COMMANDS` in `src/renderer/src/lib/slashCommands.ts`.
const commands: { name: string; description: string }[] = [
  { name: 'compact', description: 'Compact session context' },
  { name: 'login', description: 'Configure provider authentication' },
  { name: 'logout', description: 'Remove stored credentials' },
  { name: 'name', description: 'Rename session' },
  { name: 'new', description: 'Start a new chat' },
  { name: 'reload', description: 'Reload extensions, skills, prompts, settings and context files' },
  { name: 'tree', description: 'Browse session branches' },
];

const skills = ['code-review'];

const selectedIndex = 0;

// The app's `max-h-[40vh]`, of the window rather than of this page's viewport.
const MAX_HEIGHT_PX = WINDOW_HEIGHT_PX * 0.4;
---

<div
  class:list={[
    'absolute bottom-full left-0 z-20 mb-1.5 overflow-y-auto',
    SLASH_MENU_SURFACE.classes,
  ]}
  style={`width:${CHAT_INPUT_MAX_WIDTH}px;max-width:100%;max-height:${MAX_HEIGHT_PX}px`}
  role="listbox"
  aria-label="Slash commands"
>
  {
    commands.map((command, index) => (
      <div
        class:list={[SLASH_MENU_ITEM.classes, index === selectedIndex && 'bg-accent-subtle']}
        role="option"
        aria-selected={index === selectedIndex}
      >
        <span
          class:list={[
            'shrink-0 font-mono',
            index === selectedIndex ? 'text-[var(--system-accent)]' : 'text-foreground',
          ]}
        >
          /{command.name}
        </span>
        <span class="min-w-0 truncate text-muted-foreground">{command.description}</span>
      </div>
    ))
  }

  <div class="mx-auto my-0.5 h-px w-[98%] bg-border opacity-90"></div>

  {
    skills.map((skill) => (
      <div class={SLASH_MENU_ITEM.classes} role="option" aria-selected="false">
        <span class="shrink-0 font-mono text-foreground">/{skill}</span>
      </div>
    ))
  }
</div>
