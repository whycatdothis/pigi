---
import Icon from '../Icon.astro';
import { TERMINAL_TAB, TERMINAL_TAB_CLOSE, TERMINAL_TABS } from '../../lib/appUi';

/**
 * The terminal panel.
 *
 * Docked to the bottom of the window's chat column, which is where the app puts
 * it — not a floating card. The header is the app's own: one chip per tab, a
 * "+" that follows the last tab, and the close that collapses the panel.
 *
 * A tab's title is what the shell reports, falling back to the directory name
 * (terminalController.ts), so a fresh tab is named after the project.
 *
 * The colours are the site's `--terminal-*` tokens, which are the app's own
 * palette read out of terminalTheme.css at runtime — Atom One Light, or Atom One
 * Dark when the theme is dark.
 */
interface Props {
  activeTab?: string;
  tabs?: string[];
}

const { activeTab = 'pigi', tabs = ['pigi', 'pi-extension'] } = Astro.props;

const FOREGROUND = 'text-[var(--terminal-foreground)]';
const GUTTER = 'text-[var(--terminal-bright-black)]';
const PROMPT = 'text-[var(--terminal-green)]';
const PATH = 'text-[var(--terminal-cyan)]';
const DIM = 'text-[var(--terminal-white)]';
---

<div class="flex h-full flex-col bg-background">
  <div
    class:list={['h-10 shrink-0 px-2', TERMINAL_TABS.classes]}
    data-terminal-tabs
    data-variant="chip"
  >
    {
      tabs.map((tab) => (
        <button
          type="button"
          data-terminal-tab={tab}
          data-state={tab === activeTab ? 'active' : 'inactive'}
          title={tab}
          class:list={[TERMINAL_TAB.classes]}
        >
          <Icon name="terminal-2" size={13} class="shrink-0 opacity-70" />
          <span class="truncate">{tab}</span>
          <span class:list={[TERMINAL_TAB_CLOSE.classes]} aria-hidden="true">
            <Icon name="x" size={11} />
          </span>
        </button>
      ))
    }

    <button
      type="button"
      aria-label="New terminal"
      class="flex shrink-0 items-center justify-center rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <Icon name="plus" size={14} />
    </button>

    <button
      type="button"
      aria-label="Close terminal"
      class="ml-auto flex shrink-0 items-center justify-center rounded p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <Icon name="x" size={16} />
    </button>
  </div>

  <div class="min-h-0 flex-1 overflow-hidden px-2 pb-1 font-mono text-[13px] leading-[1.5]">
    <div class={GUTTER}>15:19 · ~/Programs/pigi</div>
    <div>
      <span class={PROMPT}>-&gt; </span>
      <span class={FOREGROUND}>git status --short</span>
    </div>
    <div class={FOREGROUND}>M src/components/sessionTree/SessionTreeList.tsx</div>
    <div class={FOREGROUND}>M src/components/transcript/MessageList.tsx</div>

    <div>
      <span class={PROMPT}>-&gt; </span>
      <span class={FOREGROUND}>npm test</span>
    </div>
    <div>
      <span class={PROMPT}>✓</span><span class={FOREGROUND}>
        src/lib/sessionTreeLayout.test.ts</span
      ><span class={DIM}>(31 tests) 8ms</span>
    </div>
    <div>
      <span class={PROMPT}>✓</span><span class={FOREGROUND}>
        src/lib/sessionLineage.test.ts</span
      ><span class={DIM}>(12 tests) 4ms</span>
    </div>
    <div>
      <span class={PROMPT}>✓</span><span class={FOREGROUND}>
        src/lib/readGrouping.test.ts</span
      ><span class={DIM}>(6 tests) 3ms</span>
    </div>
    <div>
      <span class={PATH}>Test Files</span><span class={FOREGROUND}> 3 passed (3)</span>
    </div>
    <div>
      <span class={PATH}>Tests</span><span class={FOREGROUND}> 49 passed (49)</span>
    </div>
    <div class={GUTTER}>15:20 · ~/Programs/pigi</div>
    <div>
      <span class={PROMPT}>-&gt; </span>
      <span class="inline-block h-[15px] w-[7px] translate-y-[2px] bg-[var(--terminal-foreground)]"
      ></span>
    </div>
  </div>
</div>
