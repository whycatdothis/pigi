---
import Icon from '../Icon.astro';
import { DIALOG_SURFACE } from '../../lib/appUi';

interface Session {
  title: string;
  project: string;
  time: string;
}

const sessions: Session[] = [
  { title: 'Add the chat minimap', project: 'pigi', time: '4m' },
  { title: 'Minimap widths while resizing', project: 'pigi', time: '18m' },
  { title: 'Fix the tree header overlap', project: 'pigi', time: '1h' },
  { title: 'Keep the session tree from blanking', project: 'pigi', time: 'Yesterday' },
  { title: 'Terminal panel resize jank', project: 'pigi', time: 'Yesterday' },
  { title: 'Ship 0.4.11', project: 'pigi', time: 'Yesterday' },
  { title: 'Rewrite the diff renderer', project: 'pi-extension', time: '3h' },
  { title: 'Popup menu grace areas', project: 'pi-extension', time: 'Mon' },
  { title: 'Skill block parsing', project: 'test-playground', time: 'Mon' },
];

const initiallySelected = sessions[0].title;
---

<div
  data-session-switcher
  data-selected-title={initiallySelected}
  role="dialog"
  aria-label="Session switcher"
  class:list={[
    'absolute left-1/2 top-4 z-30 w-full max-w-[550px] -translate-x-1/2 overflow-hidden',
    DIALOG_SURFACE.classes,
  ]}
>
  <div class="p-1 pb-0">
    <div class="flex h-11 items-center gap-2 rounded-lg border border-input/30 bg-input/50 px-2">
      <Icon name="search" size={16} class="shrink-0 text-muted-foreground opacity-50" />
      <input
        type="text"
        data-switcher-input
        role="combobox"
        aria-label="Search sessions"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="switcher-list"
        autocomplete="off"
        spellcheck="false"
        placeholder="Type freely to fuzzy search sessions"
        class="w-full min-w-0 bg-transparent text-sm text-foreground outline-none placeholder:text-muted-foreground"
      />
    </div>
  </div>

  <div
    role="listbox"
    id="switcher-list"
    aria-label="Sessions"
    data-switcher-list
    class="no-scrollbar max-h-96 overflow-x-hidden overflow-y-auto pt-1 pb-1"
  >
    {
      sessions.map((session, index) => (
        <button
          type="button"
          role="option"
          id={`switcher-option-${index}`}
          data-switcher-row
          data-title={session.title}
          data-selected={session.title === initiallySelected ? 'true' : 'false'}
          aria-selected={session.title === initiallySelected ? 'true' : 'false'}
          class="flex w-full items-center gap-2 px-2 py-1.5 text-left transition-colors data-[selected=true]:bg-foreground/10"
        >
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-sm text-foreground" data-switcher-title>
              {session.title}
            </span>
            <span class="truncate text-xs text-muted-foreground">{session.project}</span>
          </span>
          <span class="shrink-0 text-xs text-muted-foreground">{session.time}</span>
        </button>
      ))
    }
    <p class="px-2 py-6 text-center text-sm text-muted-foreground" hidden data-switcher-empty>
      No results
    </p>
  </div>
</div>
