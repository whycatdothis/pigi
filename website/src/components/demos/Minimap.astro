---
import { OVERLAY_BG } from '../../lib/appUi';
import { LINE_WIDTH_MAX_CAP, getLineWidth } from '../../lib/minimapGeometry';

export interface MinimapMessage {
  text: string;
  time: string;
}

interface Props {
  messages: MinimapMessage[];
  activeIndex: number;
  /**
   * The hero's window is a still of the app, not a working transcript: there is
   * nothing to scroll, so there is nothing for the bars to do. Only the strip is
   * drawn there, without the list it would otherwise open.
   */
  interactive?: boolean;
}

const { messages, activeIndex, interactive = true } = Astro.props;

/**
 * The widest bar, at the app's own default window: 1200px leaves a 48px strip in
 * the gutter and `LINE_WIDTH_MAX_CAP` is 48. The markup is built at that width and
 * `interactions.ts` re-measures it from the transcript it sits beside, so a
 * narrower window — down to the phone-scaled one — gets the strip that fits it
 * instead of one lying over the text.
 */
const MAX_LINE_WIDTH = LINE_WIDTH_MAX_CAP;
---

<!--
  Two elements that have to move together: the strip of bars, and the list it
  opens. Where both are present, src/scripts/interactions.ts binds them to the
  transcript they sit beside.
-->
<div
  class="absolute right-0 top-1/2 z-10 flex -translate-y-1/2 flex-col items-end gap-1.5 rounded-l py-2 pl-1 opacity-60 transition-opacity hover:opacity-90"
  data-minimap={interactive ? '' : undefined}
  role="navigation"
  aria-label="Message navigation"
>
  {
    messages.map((_message, index) => (
      <span
        class="rounded-full transition-colors"
        data-minimap-bar
        data-index={index}
        data-target={index}
        style={{
          width: `${getLineWidth(index, messages.length, MAX_LINE_WIDTH)}px`,
          height: '1.5px',
          backgroundColor:
            index === activeIndex
              ? 'var(--system-accent)'
              : 'color-mix(in srgb, var(--muted-foreground) 50%, transparent)',
        }}
      />
    ))
  }
</div>

{
  interactive && (
    <div
      class:list={[
        'absolute right-2 top-1/2 z-20 hidden w-64 -translate-y-1/2 flex-col gap-0.5 overflow-hidden rounded-lg border border-border/60 p-1 shadow-md data-[open=true]:flex',
        OVERLAY_BG.classes,
      ]}
      data-minimap-panel
      data-open="false"
    >
      {messages.map((message, index) => (
        <button
          type="button"
          class:list={[
            'flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm transition-colors',
            index === activeIndex
              ? 'bg-[var(--system-accent)]/10'
              : 'hover:bg-[var(--system-accent)]/10',
          ]}
          data-minimap-entry
          data-target={index}
        >
          <span
            class:list={[
              'min-w-0 flex-1 truncate text-[13px]',
              index === activeIndex ? 'text-[var(--system-accent)]' : 'text-foreground',
            ]}
          >
            {message.text}
          </span>
          <span class="shrink-0 text-[11px] text-muted-foreground">{message.time}</span>
        </button>
      ))}
    </div>
  )
}
