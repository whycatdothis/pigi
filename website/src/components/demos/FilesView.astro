---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import QuoteButton from '../app/QuoteButton.astro';
import { fileIconUrl } from '../../lib/fileIcons';
import { highlightLines } from '../../lib/highlight';
import { MESSAGE_LIST_MAX_WIDTH } from '../../lib/appLayout';
import { SEGMENTED, SEGMENTED_ITEM, SEGMENTED_ITEM_OFF } from '../../lib/appUi';

/**
 * The Files tab's viewer (`FileViewer.tsx`) on a markdown file: the path bar
 * with Preview / Source, the rendered page, and the highlighted source with line
 * numbers behind the other half of the toggle. Both halves are in the markup;
 * `initFileViewers` flips `data-view` on the root, which is all the toggle does
 * in a still.
 *
 * The file is the head of this repository's own `docs/architecture.md`, and the
 * preview holds a selection with its Quote button over it — the same popover
 * the chat and the diff viewer raise.
 */
const path = 'docs/architecture.md';

/** The file's first four blocks, read from the repository at build time. */
const source = readFileSync(resolve(process.cwd(), '..', path), 'utf8')
  .split('\n\n')
  .slice(0, 4)
  .join('\n\n');

/** The sentence the still has selected, quoted verbatim from `source`. */
const selected = 'Both a panel and its adjacent content consume that same property';

const lines = await highlightLines(source, 'markdown');

function escape(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function inline(text: string): string {
  return escape(text).replace(/`([^`]+)`/g, '<code>$1</code>');
}

if (!source.replace(/\n/g, ' ').includes(selected)) {
  throw new Error(`${path} no longer contains the sentence the Files still selects: "${selected}"`);
}

/** Just enough markdown for this file: headings and paragraphs with inline code. */
const blocks = source.split('\n\n').map((block) => {
  if (block.startsWith('## ')) return { tag: 'h2', before: inline(block.slice(3)) };
  if (block.startsWith('# ')) return { tag: 'h1', before: inline(block.slice(2)) };
  const text = block.replace(/\n/g, ' ');
  const at = text.indexOf(selected);
  if (at < 0) return { tag: 'p', before: inline(text) };
  return {
    tag: 'p',
    before: inline(text.slice(0, at)),
    selected,
    after: inline(text.slice(at + selected.length)),
  };
});
---

<div data-file-viewer data-view="preview" class="group/viewer flex min-h-0 flex-1 flex-col">
  <div class="flex h-8 shrink-0 items-center gap-2 px-3">
    <img alt="" class="size-4 shrink-0" src={fileIconUrl(path)} />
    <span class="min-w-0 flex-1 truncate text-caption text-muted-foreground">{path}</span>
    <div class={SEGMENTED.classes}>
      {
        (['preview', 'source'] as const).map((view) => (
          <button
            type="button"
            data-file-view={view}
            aria-pressed={view === 'preview'}
            class:list={[
              SEGMENTED_ITEM.classes,
              SEGMENTED_ITEM_OFF.classes,
              'aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-xs',
            ]}
          >
            {view === 'preview' ? 'Preview' : 'Source'}
          </button>
        ))
      }
    </div>
  </div>

  <div class="relative min-h-0 flex-1 overflow-hidden bg-background">
    <div data-file-preview class="group-data-[view=source]/viewer:hidden">
      <div
        class="markdown-body mx-auto w-full px-6 py-6 text-body"
        style={`max-width:${MESSAGE_LIST_MAX_WIDTH}px`}
      >
        {
          blocks.map(({ tag: Tag, before, selected, after }) => (
            <Tag>
              <Fragment set:html={before} />
              {selected && (
                <span class="relative">
                  <mark class="selection-tint text-inherit">{selected}</mark>
                  <QuoteButton />
                </span>
              )}
              {after && <Fragment set:html={after} />}
            </Tag>
          ))
        }
      </div>
    </div>

    <div
      data-file-source
      class="hidden w-max min-w-full px-3 py-3 font-mono group-data-[view=source]/viewer:block"
    >
      <code class="block w-max min-w-full bg-transparent p-0 font-mono text-code leading-5">
        {
          lines.map((tokens, index) => (
            <span class="flex min-h-5 w-max min-w-full leading-5">
              <span class="w-14 shrink-0 select-none bg-background pr-3 text-right text-muted-foreground tabular-nums">
                {index + 1}
              </span>
              <span class="min-w-0 whitespace-pre">
                {tokens.map((token) => (
                  <span class="code-token" style={token.style}>
                    {token.content}
                  </span>
                ))}
              </span>
            </span>
          ))
        }
      </code>
    </div>
  </div>
</div>
