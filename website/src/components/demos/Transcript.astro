---
import UserMessage from '../app/UserMessage.astro';
import AssistantMessage from '../app/AssistantMessage.astro';
import ThinkingBlock from '../app/ThinkingBlock.astro';
import ToolCard, { type DiffLine } from '../app/ToolCard.astro';
import { type MessageActionTooltip } from '../app/MessageActions.astro';
import Minimap from './Minimap.astro';
import QuoteButton from '../app/QuoteButton.astro';
import {
  MESSAGE_LIST_END_INSET_PX,
  MESSAGE_LIST_HORIZONTAL_PADDING,
  MESSAGE_LIST_MAX_WIDTH,
  MESSAGE_LIST_TOP_INSET,
} from '../../lib/appLayout';

export interface Turn {
  user: string;
  time: string;
  actionTooltip?: MessageActionTooltip & { on: 'user' | 'assistant' };
  thinking?: string;
  // `prefix` is `$` for bash, the tool's name otherwise (`read`, `edit`) — never `$ read`.
  tool?: {
    command: string;
    prefix?: string;
    status?: 'success' | 'error' | 'running';
    output?: string[];
    diff?: DiffLine[];
    duration: string;
  };
  reply?: string;
  // Must be a substring of `reply`.
  quote?: string;
  last?: boolean;
}

interface Props {
  turns: Turn[];
  scroll?: boolean;
  minimap?: boolean;
}

const { turns, scroll = false, minimap = false } = Astro.props;

function tooltipFor(turn: Turn, on: 'user' | 'assistant'): MessageActionTooltip | undefined {
  return turn.actionTooltip?.on === on ? turn.actionTooltip : undefined;
}

const column = 'mx-auto flex w-full flex-col';
const columnStyle = [
  `max-width:${MESSAGE_LIST_MAX_WIDTH}px`,
  `padding-inline:${MESSAGE_LIST_HORIZONTAL_PADDING}px`,
  `padding-top:${MESSAGE_LIST_TOP_INSET}px`,
  `padding-bottom:${MESSAGE_LIST_END_INSET_PX}px`,
].join(';');
---

<div class="relative min-h-0 flex-1" data-minimap-scope={minimap ? '' : undefined}>
  <!-- `overflow: hidden` is still a scroll container, so `initTranscriptClips` can show a still at its end. -->
  <div
    class:list={[scroll ? 'no-scrollbar h-full overflow-y-auto' : 'h-full overflow-hidden']}
    data-minimap-scroll={scroll ? '' : undefined}
    data-transcript-clip={scroll ? undefined : ''}
  >
    <div class={column} style={columnStyle}>
      {
        turns.map((turn, index) => (
          <div data-message-index={index}>
            <UserMessage
              time={turn.time}
              actions={tooltipFor(turn, 'user') ? 'full' : false}
              showActions={tooltipFor(turn, 'user') !== undefined}
              actionTooltip={tooltipFor(turn, 'user')}
            >
              {turn.user}
            </UserMessage>

            <div class="flex flex-col gap-2 pt-2">
              {turn.thinking && <ThinkingBlock duration="2s">{turn.thinking}</ThinkingBlock>}
              {turn.tool && (
                <ToolCard
                  prefix={turn.tool.prefix}
                  command={turn.tool.command}
                  output={turn.tool.output}
                  diff={turn.tool.diff}
                  status={turn.tool.status}
                  duration={turn.tool.duration}
                />
              )}
            </div>

            {turn.reply && (
              <div class="mt-2">
                <AssistantMessage
                  time={turn.last ? turn.time : undefined}
                  showActions={tooltipFor(turn, 'assistant') !== undefined}
                  actionTooltip={tooltipFor(turn, 'assistant')}
                >
                  {turn.quote && turn.reply.includes(turn.quote) ? (
                    <p>
                      {turn.reply.slice(0, turn.reply.indexOf(turn.quote))}
                      <span class="relative">
                        <mark class="selection-tint text-inherit">{turn.quote}</mark>
                        <QuoteButton interactive />
                      </span>
                      {turn.reply.slice(turn.reply.indexOf(turn.quote) + turn.quote.length)}
                    </p>
                  ) : (
                    <p>{turn.reply}</p>
                  )}
                </AssistantMessage>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  {
    minimap && (
      <Minimap
        messages={turns.map((turn) => ({ text: turn.user, time: turn.time }))}
        activeIndex={turns.length - 1}
      />
    )
  }
</div>
