---
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';
import { SIDEBAR_DEFAULT_WIDTH } from '../../lib/appLayout';
import { SIDEBAR_MENU_BUTTON } from '../../lib/appUi';

/**
 * The settings view's sidebar (`settings/SettingsSidebar.tsx`): Back to app,
 * then pigi's own pages and pi's, with the icons and labels of the app's
 * section registry (`lib/settingsSections.ts`, a React module, so copied here).
 */
const groups: { label: string; sections: { label: string; icon: IconName }[] }[] = [
  {
    label: 'pigi',
    sections: [
      { label: 'Appearance', icon: 'palette' },
      { label: 'Chat', icon: 'message-circle' },
      { label: 'Shortcuts', icon: 'keyboard' },
      { label: 'Privacy', icon: 'shield-check' },
    ],
  },
  {
    label: 'pi',
    sections: [
      { label: 'Models & Thinking', icon: 'cpu' },
      { label: 'Message Delivery', icon: 'send' },
      { label: 'Compaction', icon: 'arrows-minimize' },
      { label: 'Retry', icon: 'refresh' },
      { label: 'Resources', icon: 'box' },
      { label: 'Advanced', icon: 'adjustments-horizontal' },
    ],
  },
];
---

<aside
  class="flex shrink-0 flex-col bg-[var(--sidebar-solid)] text-sidebar-foreground"
  style={`width:${SIDEBAR_DEFAULT_WIDTH}px`}
>
  <div class="flex flex-col gap-2 p-2">
    <div class="h-10"></div>
    <div class={SIDEBAR_MENU_BUTTON.classes}>
      <Icon name="arrow-left" />
      <span>Back to app</span>
    </div>
  </div>
  <div class="flex min-h-0 flex-1 flex-col overflow-hidden p-2">
    {
      groups.map((group) => (
        <div class="flex flex-col gap-1 pb-2">
          <p class="flex h-8 shrink-0 items-center px-2 pt-3 pb-0 text-body text-muted-foreground">
            {group.label}
          </p>
          <ul class="flex w-full min-w-0 flex-col gap-0">
            {group.sections.map((section) => (
              <li
                class:list={[SIDEBAR_MENU_BUTTON.classes, 'text-sidebar-foreground/85']}
                data-active={section.label === 'Appearance' ? 'true' : undefined}
              >
                <Icon name={section.icon} />
                <span>{section.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</aside>
