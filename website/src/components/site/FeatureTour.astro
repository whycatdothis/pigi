---
import AppWindow from '../app/AppWindow.astro';
import Transcript from '../demos/Transcript.astro';
import SessionTreeDialog from '../demos/SessionTreeDialog.astro';
import SessionTreeHelp from '../demos/SessionTreeHelp.astro';
import ViewModes from '../demos/ViewModes.astro';
import SessionSwitcher from '../demos/SessionSwitcher.astro';
import TerminalPanel from '../demos/TerminalPanel.astro';
import FilesSidebar from '../demos/FilesSidebar.astro';
import FilesView from '../demos/FilesView.astro';
import GitSidebar from '../demos/GitSidebar.astro';
import GitView from '../demos/GitView.astro';
import QuotePanel from '../demos/QuotePanel.astro';
import PackagesPage from '../demos/PackagesPage.astro';
import SettingsSidebar from '../demos/SettingsSidebar.astro';
import AppearanceSettings from '../demos/AppearanceSettings.astro';
import StageLayer from './StageLayer.astro';
import { FEATURE_STEPS } from '../../lib/features';
import {
  COPY_SESSION_TITLE,
  builderTurns,
  forkTurns,
  quotePanelQuotes,
  quoteTurns,
  sidebarRows,
  subagentSessionRows,
  subagentTurns,
  switchSessionRows,
  switchSessions,
  terminalTurns,
  treeTurns,
} from '../../lib/sessions';

// Stills stack in one grid cell rather than absolute positioning, so hidden
// layers keep layout for `initMinimaps` and `initTranscriptClips` to measure.
const active = 0;
---

<section id="features" data-stage class="border-t border-border/70">
  <div class="mx-auto max-w-[1440px] px-6">
    <div
      role="tablist"
      aria-label="Feature tour"
      class="no-scrollbar -mx-6 flex gap-1 overflow-x-auto px-6 pt-10 md:mx-0 md:flex-wrap md:overflow-visible md:px-0 lg:hidden"
    >
      {
        FEATURE_STEPS.map((step, index) => (
          <button
            type="button"
            role="tab"
            id={`stage-chip-${step.id}`}
            aria-controls={`stage-copy-${step.id}`}
            aria-selected={index === active ? 'true' : 'false'}
            tabindex={index === active ? 0 : -1}
            data-stage-chip
            data-active={index === active ? 'true' : 'false'}
            class="flex shrink-0 items-center gap-2 rounded-lg px-2.5 py-1.5 text-[13px] whitespace-nowrap text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-muted data-[active=true]:text-foreground"
          >
            <span class="font-mono text-[11px] tabular-nums text-muted-foreground/60">
              {String(index + 1).padStart(2, '0')}
            </span>
            {step.label}
          </button>
        ))
      }
    </div>

    <div
      class="mt-6 grid min-w-0 gap-8 lg:mt-0 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:gap-14 lg:py-16"
    >
      <!--
        Without script there is no `data-active`, so no stacking: chapters read as
        an article. `lg:pb-24` keeps the sticky window pinned through the last
        chapter; without it the still slides out of the viewport.
      -->
      <div data-stage-rail class="grid min-w-0 gap-10 lg:order-2 lg:block lg:pb-24">
        {
          FEATURE_STEPS.map((step, index) => (
            <section
              id={`stage-copy-${step.id}`}
              aria-labelledby={`stage-chip-${step.id}`}
              data-stage-copy
              data-current={index === active ? 'true' : 'false'}
              class:list={[
                'group/step max-w-xl transition-[opacity,transform] duration-300 data-[active]:col-start-1 data-[active]:row-start-1 data-[active=false]:invisible data-[active=false]:translate-y-1 data-[active=false]:opacity-0 lg:flex lg:max-w-none lg:flex-col lg:justify-center lg:border-l lg:border-border/70 lg:pl-8 lg:transition-none',
                // At 64vh the first chapter went current while the window's
                // bottom was still off-screen; full height waits for it to settle.
                index === 0 ? 'lg:min-h-screen' : 'lg:min-h-[64vh]',
              ]}
            >
              <span
                data-stage-number
                class="font-mono text-[11px] tabular-nums text-muted-foreground/60 transition-colors group-data-[current=true]/step:text-[var(--system-accent)]"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-2 text-[24px] font-semibold leading-[1.15] tracking-[-0.01em] text-foreground lg:mt-3 lg:text-[23px]">
                {step.label}
              </h2>
              <p
                class="mt-2.5 text-[15px] leading-7 text-muted-foreground lg:mt-4 lg:text-[14px] lg:leading-6"
                set:html={step.body}
              />
            </section>
          ))
        }
      </div>

      <div
        class="min-w-0 lg:order-1 lg:sticky lg:top-0 lg:flex lg:h-screen lg:items-center lg:self-start"
      >
        <div data-stage-scene class="grid min-w-0 *:min-w-0">
          <StageLayer active>
            <AppWindow title="Bump electron-builder" composerText="/" slashMenuOpen>
              <Transcript turns={builderTurns} />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="Appearance" page>
              <SettingsSidebar slot="sidebar" />
              <AppearanceSettings />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="The transcript flickers" viewMode="compact" viewMenuOpen>
              <ViewModes />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow
              title="Packages"
              page
              packagesActive
              sessions={sidebarRows(COPY_SESSION_TITLE)}
            >
              <PackagesPage />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title={COPY_SESSION_TITLE} tab="git">
              <GitSidebar slot="sidebar" />
              <GitView />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title={COPY_SESSION_TITLE} tab="files" running>
              <FilesSidebar slot="sidebar" />
              <FilesView />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title={COPY_SESSION_TITLE} rightSidebarOpen>
              <Transcript turns={quoteTurns} />
              <QuotePanel slot="right" quotes={quotePanelQuotes} />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="Keep the session tree from blanking">
              <Transcript turns={forkTurns} />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="Add the chat minimap" overlayOpen>
              <Transcript turns={treeTurns} />
              <SessionTreeDialog slot="overlay" />
              <SessionTreeHelp slot="overlay" />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title={COPY_SESSION_TITLE} sessions={subagentSessionRows} running>
              <Transcript turns={subagentTurns} />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="Fix the tree header overlap" terminalOpen>
              <Transcript turns={terminalTurns} />
              <TerminalPanel slot="panel" />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <AppWindow title="Add the chat minimap">
              <Transcript turns={treeTurns} />
              <SessionSwitcher slot="overlay" />
            </AppWindow>
          </StageLayer>

          <StageLayer>
            <!-- Stacked, not swapped in the DOM: each frame stays laid out for its minimap. -->
            <div data-session-cycle class="grid min-w-0 grid-cols-[minmax(0,1fr)]">
              {
                switchSessions.map((session, index) => (
                  <div
                    data-session-frame
                    data-session-index={index}
                    data-active={index === 0 ? 'true' : 'false'}
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    class="col-start-1 row-start-1 min-w-0 data-[active=false]:invisible data-[active=false]:opacity-0"
                  >
                    <AppWindow title={session.title} sessions={switchSessionRows}>
                      <Transcript turns={session.turns} scroll minimap />
                    </AppWindow>
                  </div>
                ))
              }
            </div>
          </StageLayer>
        </div>
      </div>
    </div>
  </div>
</section>
