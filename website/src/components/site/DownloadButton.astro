---
import Icon from '../Icon.astro';
import { LATEST_RELEASE_URL, UMAMI_EVENT_DOWNLOAD } from '../../lib/site';
import { BUTTON_BASE, BUTTON_FILLED, BUTTON_HERO_SIZE, BUTTON_SIZE_DEFAULT } from '../../lib/appUi';

/**
 * The download button, in the hero and in the header.
 *
 * The markup points at the release page, which always works. src/scripts/
 * interactions.ts upgrades the href to the arm64 DMG's direct URL once the
 * releases API answers, and leaves it alone if it does not.
 *
 * The shape is the app's own Button — base, filled variant, `size="default"` in
 * the header — with the hero at the page's scale instead, since the app has no
 * button that tall. See src/lib/appUi.ts for what is copied and from where.
 *
 * The label names the architecture. The app publishes one DMG and it is arm64, so
 * a button that only said "macOS" would hand an Intel reader a file that cannot
 * run.
 */
interface Props {
  /** `hero` is the page's primary action; `compact` matches the app's `size="default"`. */
  variant?: 'hero' | 'compact';
  class?: string;
}

const { variant = 'hero', class: className } = Astro.props;
---

<a
  href={LATEST_RELEASE_URL}
  data-download-link
  data-umami-event={UMAMI_EVENT_DOWNLOAD}
  class:list={[
    BUTTON_BASE.classes,
    BUTTON_FILLED.classes,
    variant === 'hero' ? BUTTON_HERO_SIZE.classes : BUTTON_SIZE_DEFAULT.classes,
    className,
  ]}
>
  <Icon name="download" size={variant === 'hero' ? 17 : 14} />
  {variant === 'hero' ? 'Download for Apple Silicon' : 'Download'}
  {
    variant === 'hero' && (
      <Icon
        name="arrow-right"
        size={16}
        class="opacity-60 transition-transform group-hover/button:translate-x-0.5"
      />
    )
  }
</a>
