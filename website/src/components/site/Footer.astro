---
import Icon from '../Icon.astro';
import {
  PI_URL,
  REPO_URL,
  RELEASES_URL,
  LICENSE_URL,
  LICENSE_NAME,
  UMAMI_EVENT_REPO,
} from '../../lib/site';

const columns = [
  {
    title: 'pigi',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Changelog', href: '/changelog' },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'GitHub', href: REPO_URL, event: UMAMI_EVENT_REPO },
      { label: 'Releases', href: RELEASES_URL },
      { label: 'Issues', href: `${REPO_URL}/issues` },
      { label: LICENSE_NAME, href: LICENSE_URL },
    ],
  },
];
---

<footer class="border-t border-border/70">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <div class="flex items-center gap-2">
          <img src="/icon-256.png" alt="" width="24" height="24" class="rounded-[6px]" />
          <span class="text-sm font-semibold text-foreground">pigi</span>
        </div>
        <p class="mt-3 text-[13px] leading-6 text-muted-foreground">
          A desktop GUI for pi. Independent and unofficial — pi itself is built by{' '}
          <a href={PI_URL} class="text-foreground underline underline-offset-2">Earendil Inc.</a>
        </p>
      </div>

      <div class="flex gap-16">
        {
          columns.map((column) => (
            <div>
              <h3 class="mb-3 text-[13px] font-medium text-foreground">{column.title}</h3>
              <ul class="flex flex-col gap-2">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      data-umami-event={link.event}
                      class="text-[13px] text-muted-foreground transition-colors hover:text-foreground"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-border/70 pt-6"
    >
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} pigi contributors. Licensed {LICENSE_NAME}.
      </p>
      <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
        <Icon name="lock" size={13} />
        This site sets no cookies. Traffic is counted without them.
      </p>
    </div>
  </div>
</footer>
