---
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  eyebrow: string;
  icon: IconName;
  title: string;
  /** `wide` keeps the body text on one line next to a full-width demo. */
  wide?: boolean;
}

const { eyebrow, icon, title, wide = false } = Astro.props;
---

<div class:list={['flex flex-col', wide ? 'max-w-3xl' : 'max-w-xl']}>
  <p class="mb-3 flex items-center gap-2 text-[13px] font-medium text-[var(--system-accent)]">
    <Icon name={icon} size={15} />
    {eyebrow}
  </p>
  <h2
    class="text-[26px] font-semibold leading-[1.3] tracking-[-0.01em] text-foreground md:text-[30px]"
  >
    {title}
  </h2>
  <div class="mt-4 flex flex-col gap-3 text-[15px] leading-7 text-muted-foreground">
    <slot />
  </div>
</div>
