---
import Icon from '../Icon.astro';
import { REPO_URL, UMAMI_EVENT_REPO } from '../../lib/site';

const navLinks = [
  // Absolute: `#features` only exists on the homepage.
  { href: '/#features', label: 'Features' },
  { href: '/changelog/', label: 'Changelog' },
];
---

<header
  data-site-header
  class="sticky top-0 z-50 transition-colors data-[scrolled]:bg-[var(--page-background)]/85 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-14 max-w-[1248px] items-center gap-6 px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="pigi home">
      <img src="/icon-256.png" alt="" width="24" height="24" class="rounded-[6px]" />
      <span class="text-sm font-semibold text-foreground">pigi</span>
    </a>

    <nav class="ml-auto hidden items-center gap-6 text-[13px] md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-muted-foreground transition-colors hover:text-foreground">
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={REPO_URL}
      data-umami-event={UMAMI_EVENT_REPO}
      aria-label="GitHub"
      class="ml-auto flex items-center gap-1.5 text-[13px] text-muted-foreground transition-colors hover:text-foreground md:ml-0"
    >
      <Icon name="brand-github" size={15} />
      <span class="hidden md:inline">GitHub</span>
    </a>

    <button
      type="button"
      data-theme-toggle
      aria-label="Switch theme"
      class="flex size-8 shrink-0 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <Icon name="moon" size={16} class="dark:hidden" />
      <Icon name="sun" size={16} class="hidden dark:block" />
    </button>
  </div>
</header>
