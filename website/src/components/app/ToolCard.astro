---
import Icon from '../Icon.astro';

export interface DiffLine {
  type: 'add' | 'remove' | 'context' | 'separator';
  number?: number;
  content?: string;
}

interface Props {
  /** `$` for a shell command, `→` for a file edit. */
  prefix?: string;
  command: string;
  output?: string[];
  diff?: DiffLine[];
  status?: 'success' | 'error' | 'running';
  duration?: string;
}

const {
  prefix = '$',
  command,
  output = [],
  diff,
  status = 'success',
  duration = '0.3s',
} = Astro.props;

const statusClassName = {
  success: 'text-success-fg',
  error: 'text-danger-fg',
  running: 'text-warning-fg',
}[status];

const diffLineClassName = {
  add: 'bg-success-bg text-success-fg',
  remove: 'bg-danger-bg text-danger-fg',
  context: 'text-muted-foreground',
};
---

<div
  class="overflow-clip rounded-surface-sm border border-border/65 bg-muted/25 px-3 pt-0 pb-1.5 text-body text-muted-foreground"
>
  <div
    class="-mx-3 flex items-start gap-1 px-3 pt-1.5 font-mono text-code font-medium leading-5 text-foreground"
  >
    <span class="shrink-0">{prefix}</span>
    <span class="min-w-0 break-words [overflow-wrap:anywhere]">{command}</span>
  </div>

  {
    diff && (
      <div class="overflow-hidden rounded font-mono text-code-compact leading-5">
        {diff.map((line) =>
          line.type === 'separator' ? (
            <div class="bg-muted/30 px-3 py-0.5 text-caption text-muted-foreground">⋯</div>
          ) : (
            <div class:list={['flex', diffLineClassName[line.type]]}>
              <span class="w-4 shrink-0 select-none text-center opacity-50">
                {line.type === 'add' ? '+' : line.type === 'remove' ? '-' : ' '}
              </span>
              <span class="w-8 shrink-0 select-none text-right tabular-nums opacity-50">
                {line.number ?? ''}
              </span>
              <span class="min-w-0 whitespace-pre-wrap break-all px-2">{line.content}</span>
            </div>
          ),
        )}
      </div>
    )
  }

  {
    output.length > 0 && (
      // set:text, not a child: the formatter's whitespace inside <pre> would render.
      <pre
        class="overflow-x-auto overscroll-x-none whitespace-pre font-mono text-code leading-5 text-muted-foreground"
        set:text={output.join('\n')}
      />
    )
  }

  <div
    class:list={[
      '-mx-3 -mb-2 flex items-center justify-between gap-1.5 px-3 py-1.5 text-caption font-medium',
      statusClassName,
    ]}
  >
    <span class="flex items-center gap-1">
      {status === 'success' && <Icon name="check" size={14} stroke={2} />}
      {status === 'error' && <Icon name="x" size={14} stroke={2} />}
      {
        status === 'running' && (
          <span class="inline-flex animate-spin motion-reduce:animate-none">
            <Icon name="loader-2" size={14} />
          </span>
        )
      }
      <span class="tabular-nums">{duration}</span>
    </span>
  </div>
</div>
