---
import { KBD, QUOTE_SELECTION_BUTTON } from '../../lib/appUi';

// The parent must be the selection's `relative` box. Inert unless `interactive`:
// only the quote chapter has a panel to add to (initQuoteStills).
interface Props {
  interactive?: boolean;
}

const { interactive = false } = Astro.props;
const Tag = interactive ? 'button' : 'span';
---

<Tag
  type={interactive ? 'button' : undefined}
  aria-hidden={interactive ? undefined : 'true'}
  data-quote-button={interactive ? '' : undefined}
  class:list={[QUOTE_SELECTION_BUTTON.classes, 'bottom-full left-0 mb-1.5 whitespace-nowrap']}
>
  Quote
  <kbd data-slot="kbd" class:list={[KBD.classes, 'h-4 min-w-4 text-2xs']}>Q</kbd>
</Tag>
