---
import Icon from '../Icon.astro';
import { NEW_CHAT_HEADING } from '../../lib/appCopy';

interface Props {
  /** New-session mode centres the box and names the state instead of the follow-up. */
  variant?: 'followUp' | 'newSession';
  model?: string;
  thinking?: string;
  gitBranch?: string;
  contextUsage?: string;
}

const {
  variant = 'followUp',
  model = 'DeepSeek V4.1 Flash',
  thinking = 'max',
  gitBranch = 'main',
  contextUsage = '1.2%/1000k (auto)',
} = Astro.props;

const isNewSession = variant === 'newSession';
---

<div class="shrink-0 px-4 pb-1">
  <div class="relative mx-auto w-full max-w-[796px]">
    <div
      class:list={[
        'flex h-auto flex-col rounded-3xl border bg-background shadow-[0_10px_34px_rgb(0_0_0_/_0.075)]',
        !isNewSession && 'min-h-28',
      ]}
    >
      {
        isNewSession && (
          <h1 class="mb-12 mt-12 text-center text-4xl font-normal text-foreground">
            {NEW_CHAT_HEADING}
          </h1>
        )
      }
      <div
        class:list={[
          'flex-initial text-sm leading-5 text-muted-foreground/70',
          isNewSession ? 'min-h-24 px-4 pb-2 pt-4' : 'min-h-16 px-4 pb-2 pt-4',
        ]}
      >
        {isNewSession ? 'Type # to quick change project.' : 'Ask for follow-up changes'}
      </div>

      <div class="flex min-w-0 items-center justify-between gap-2 px-2.5 pb-2.5 pt-0">
        <div class="flex min-w-0 flex-1 items-center gap-1.5 overflow-hidden px-1">
          <span
            class="flex size-7 shrink-0 items-center justify-center rounded-full text-muted-foreground"
          >
            <Icon name="plus" size={16} />
          </span>
        </div>
        <div class="flex shrink-0 items-baseline gap-1.5 pl-2">
          <span class="text-sm text-foreground">{model}</span>
          <span class="text-xs text-muted-foreground">{thinking}</span>
          <Icon name="chevron-down" size={14} class="shrink-0 self-center text-muted-foreground" />
        </div>
        <span
          class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted-foreground text-background"
        >
          <Icon name="arrow-up" size={16} />
        </span>
      </div>
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-[796px] items-center justify-between gap-4 pt-1.5 text-sm text-muted-foreground"
  >
    <span class="flex min-w-0 items-center gap-1.5">
      <Icon name="git-branch" size={16} class="shrink-0" />
      <span class="truncate">{gitBranch}</span>
    </span>
    <span class="shrink-0 tabular-nums">{contextUsage}</span>
  </div>
</div>
