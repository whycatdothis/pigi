---
import { superellipseRectPath } from '../../../../src/renderer/src/lib/squirclePath';

// Copy of the app's components/panelIcon.tsx, which is React so can't be imported here.
interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;

const STRIP = {
  left: { x: 4.5, y: 6, width: 6, height: 12 },
  right: { x: 13.5, y: 6, width: 6, height: 12 },
}[side];

const outline = superellipseRectPath({ x: 2.25, y: 3.75, width: 19.5, height: 16.5, radius: 2.25 });
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4 shrink-0">
  <rect {...STRIP} fill="currentColor" fill-opacity="0.45"></rect>
  <path d={outline} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
</svg>
