---
import MessageActions, { type MessageActionTooltip } from './MessageActions.astro';

interface Props {
  time?: string;
  actions?: 'full' | 'copy' | false;
  showActions?: boolean;
  actionTooltip?: MessageActionTooltip;
}

const { time, actions = false, showActions = false, actionTooltip } = Astro.props;
---

<div class="group flex justify-end pb-2 pt-6">
  <div class="flex max-w-[85%] flex-col items-end">
    <div class="w-fit max-w-full overflow-clip rounded-surface-lg bg-accent-subtle px-3.5 py-2">
      <div class="whitespace-pre-wrap break-words text-body leading-6 text-foreground">
        <slot />
      </div>
    </div>
    <div class="flex w-full items-center justify-end gap-2">
      {
        actions !== false && (
          <MessageActions
            kind={actions}
            time={time}
            visible={showActions}
            tooltip={actionTooltip}
          />
        )
      }
      {actions === false && time && <span class="text-caption text-muted-foreground">{time}</span>}
    </div>
  </div>
</div>
