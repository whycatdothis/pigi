---
import MessageActions from './MessageActions.astro';

interface Props {
  time?: string;
  /** Right-aligned bubbles carry the user's own words; the slot holds them. */
  actions?: 'full' | 'copy' | false;
}

const { time, actions = false } = Astro.props;
---

<!-- pt-6 / pb-2 is the app's spacing above a user message and below it. -->
<div class="group flex justify-end pb-2 pt-6">
  <div class="flex max-w-[85%] flex-col items-end">
    <div class="w-fit max-w-full overflow-clip rounded-2xl bg-muted px-3.5 py-2">
      <div class="whitespace-pre-wrap break-words text-[15px] leading-6 text-foreground">
        <slot />
      </div>
    </div>
    <div class="flex w-full items-center justify-end gap-2">
      {actions !== false && <MessageActions kind={actions} time={time} />}
      {actions === false && time && <span class="text-xs text-muted-foreground">{time}</span>}
    </div>
  </div>
</div>
