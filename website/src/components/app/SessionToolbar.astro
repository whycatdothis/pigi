---
import Icon from '../Icon.astro';
import PanelIcon from './PanelIcon.astro';
import ViewModeMenu, { type ViewModeName } from '../demos/ViewModeMenu.astro';
import {
  CHIP_TAB,
  CHIP_TABS,
  TOOLBAR_BUTTON,
  TOOLBAR_BUTTON_ON,
  TOOLTIP_CONTENT,
  KBD,
} from '../../lib/appUi';

export type WorkspaceTabName = 'chat' | 'files' | 'git';

// Tooltips here never take the pointer, so unlike the app the tree tooltip has no `?`
// button; it lives in the session tree's header (SessionTreeDialog.astro) instead.
interface Props {
  title: string;
  tab?: WorkspaceTabName;
  running?: boolean;
  terminalOpen?: boolean;
  viewMode?: ViewModeName | null;
  viewMenuOpen?: boolean;
  rightSidebarOpen?: boolean;
}

const {
  title,
  tab = 'chat',
  running = false,
  terminalOpen = false,
  viewMode = null,
  viewMenuOpen = false,
  rightSidebarOpen = false,
} = Astro.props;

const tabs = [
  { id: 'files', label: 'Files', icon: 'lucide-folder-open', key: '⌘ 2' },
  { id: 'git', label: 'Git', icon: 'lucide-git-branch', key: '⌘ 3' },
] as const;

const TAB_KBD = `${KBD.classes} h-4 min-w-4 text-3xs [grid-area:1/1] opacity-0 transition-opacity group-hover/tab:opacity-100 @max-[600px]:hidden`;
const TAB = 'group/tab @max-[320px]:px-2 @max-[220px]:px-1';
---

<!-- @max breakpoints are the header's container width, copied from WorkspaceTabs.tsx and SessionToolbar.tsx. -->
<div
  class="@container relative z-10 flex h-11 shrink-0 items-center gap-2 border-b-[0.5px] border-foreground/27 pr-3 @max-[320px]:pr-2 @max-[220px]:pr-1"
>
  <div
    data-variant="chip"
    class:list={[CHIP_TABS.classes, 'min-w-0 max-w-full shrink @max-[220px]:gap-0']}
  >
    <span
      data-state={tab === 'chat' ? 'active' : 'inactive'}
      class:list={[
        TAB,
        CHIP_TAB.classes,
        'ml-2 w-78 min-w-36 shrink basis-auto justify-start pl-2 text-body @max-[600px]:min-w-0 @max-[320px]:w-auto @max-[320px]:flex-none',
      ]}
    >
      <Icon name="message-circle" class="hidden @max-[320px]:inline" />
      <span class="min-w-0 truncate @max-[320px]:hidden">{title}</span>
      <span class="ml-auto grid shrink-0 place-items-center">
        <kbd data-slot="kbd" class={TAB_KBD}>⌘ 1</kbd>
        {
          running && tab !== 'chat' && (
            <span class="flex animate-[spin_1.8s_linear_infinite] transition-opacity [grid-area:1/1] group-hover/tab:opacity-0 motion-reduce:animate-none @max-[600px]:group-hover/tab:opacity-100">
              <Icon name="loader-2" size={14} />
            </span>
          )
        }
      </span>
    </span>
    {
      tabs.map((item) => (
        <span
          data-state={tab === item.id ? 'active' : 'inactive'}
          class:list={[TAB, CHIP_TAB.classes, 'flex-none justify-center text-ui']}
        >
          <Icon name={item.icon} />
          <span class="min-w-0 truncate @max-[500px]:hidden">{item.label}</span>
          <span class="grid shrink-0 place-items-center">
            <kbd data-slot="kbd" class={TAB_KBD}>
              {item.key}
            </kbd>
          </span>
        </span>
      ))
    }
  </div>

  <div class="flex-1"></div>

  <div class="flex shrink-0 items-center gap-2 @max-[430px]:hidden">
    <!-- Tabler draws binary-tree-2 small: scale up and divide the stroke back out, as the app does. -->
    <div class="group relative">
      <button type="button" aria-label="Session tree" class:list={[TOOLBAR_BUTTON.classes]}>
        <Icon name="binary-tree-2" size={15} class="scale-[1.15] [stroke-width:calc(1.5/1.15)]" />
      </button>
      <span class:list={['app-tooltip', TOOLTIP_CONTENT.classes]}>Session tree</span>
    </div>

    <div class="group relative">
      <button
        type="button"
        data-terminal-toggle
        aria-label="Toggle terminal"
        aria-pressed={terminalOpen}
        class:list={[TOOLBAR_BUTTON.classes, terminalOpen && TOOLBAR_BUTTON_ON.classes]}
      >
        <Icon name="terminal-2" size={16} />
      </button>
      <span class:list={['app-tooltip', TOOLTIP_CONTENT.classes]}>
        Toggle terminal
        <kbd data-slot="kbd" class:list={[KBD.classes, 'h-5 min-w-5 text-caption']}>⌘ J</kbd>
      </span>
    </div>

    <div class="relative">
      <button
        type="button"
        data-view-menu-trigger
        title="View mode"
        aria-haspopup="menu"
        aria-expanded={viewMenuOpen}
        class:list={['group relative', TOOLBAR_BUTTON.classes]}
      >
        <Icon name="filter-2" size={16} />
      </button>
      {viewMode !== null && <ViewModeMenu open={viewMenuOpen} active={viewMode} />}
    </div>
  </div>

  <span
    aria-hidden="true"
    class="hidden size-7 items-center justify-center rounded p-1 text-muted-foreground @max-[430px]:flex @max-[220px]:size-5"
  >
    <Icon name="dots" size={16} />
  </span>

  <div class="group relative @max-[220px]:hidden">
    <button
      type="button"
      aria-label="Toggle right sidebar"
      aria-pressed={rightSidebarOpen}
      class:list={[TOOLBAR_BUTTON.classes, rightSidebarOpen && TOOLBAR_BUTTON_ON.classes]}
    >
      <PanelIcon side="right" />
    </button>
    <span class:list={['app-tooltip app-tooltip-end', TOOLTIP_CONTENT.classes]}>
      Toggle right sidebar
    </span>
  </div>
</div>
