---
import Icon from '../Icon.astro';

/**
 * The app's round `?` — `SessionTreeHelpButton` in `SessionTreeHelpDialog.tsx`.
 *
 * It has three homes in the app, and all three are on this page: to the right of
 * the tree's message count, inside the tree button's toolbar tooltip, and inside
 * the tree action's message tooltip. In the app it is a button that opens the
 * explanation, so here it is a button too: `initTreeHelp` toggles the
 * `SessionTreeHelp` dialog in the same window, and a placement that has no dialog
 * beside it simply does nothing.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-tree-help-toggle
  aria-label="What is the session tree?"
  aria-expanded="false"
  class:list={[
    'flex size-5 shrink-0 cursor-pointer items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground',
    className,
  ]}
>
  <Icon name="question-mark" size={12} />
</button>
