---
import Sidebar from './Sidebar.astro';
import type { SessionRow } from '../../lib/sessions';
import SessionToolbar, { type WorkspaceTabName } from './SessionToolbar.astro';
import ChatInput from './ChatInput.astro';
import SlashMenu from '../demos/SlashMenu.astro';
import {
  RIGHT_SIDEBAR_DEFAULT_WIDTH,
  TERMINAL_DEFAULT_HEIGHT,
  WINDOW_HEIGHT_PX,
  WINDOW_MIN_WIDTH_PX,
  WINDOW_WIDTH_PX,
} from '../../lib/appLayout';
import type { ViewModeName } from '../demos/ViewModeMenu.astro';

// Below WINDOW_MIN_WIDTH_PX the window keeps that width and is scaled down to fit
// ([data-window-fit] in interactions.ts); reflowing it would draw a layout the app never has.
interface Props {
  title: string;
  composerText?: string;
  slashMenuOpen?: boolean;
  terminalOpen?: boolean;
  viewMenuOpen?: boolean;
  overlayOpen?: boolean;
  viewMode?: ViewModeName | null;
  sessions?: SessionRow[];
  tab?: WorkspaceTabName;
  running?: boolean;
  /** A full page (Packages, Settings): no header tabs, no composer. */
  page?: boolean;
  packagesActive?: boolean;
  rightSidebarOpen?: boolean;
}

const {
  title,
  composerText,
  slashMenuOpen = false,
  terminalOpen = false,
  viewMenuOpen = false,
  overlayOpen = false,
  viewMode = null,
  sessions,
  tab = 'chat',
  running = false,
  page = false,
  packagesActive = false,
  rightSidebarOpen = false,
} = Astro.props;

const chatColumn = !page && tab === 'chat';

const chatStyle = `bottom:${terminalOpen ? `${TERMINAL_DEFAULT_HEIGHT}px` : '0'}`;
---

<div data-window-fit={WINDOW_MIN_WIDTH_PX}>
  <div data-window-canvas class="origin-top-left">
    <div
      class="group/view relative mx-auto w-full max-w-none overflow-hidden rounded-xl border border-[var(--window-border)] bg-background shadow-[var(--window-shadow)]"
      style={`height:${WINDOW_HEIGHT_PX}px; max-width:${WINDOW_WIDTH_PX}px`}
      data-window-title={title}
      data-view-modes={viewMode !== null ? 'true' : undefined}
      data-active={viewMode ?? undefined}
    >
      <div class="pointer-events-none absolute left-5 top-5 z-10 flex gap-2">
        <span class="traffic-light rounded-full bg-[#ff5f57]"></span>
        <span class="traffic-light rounded-full bg-[#febc2e]"></span>
        <span class="traffic-light rounded-full bg-[#28c840]"></span>
      </div>

      <div class="flex h-full">
        {
          Astro.slots.has('sidebar') ? (
            <slot name="sidebar" />
          ) : (
            <Sidebar
              activeTitle={page ? undefined : title}
              sessions={sessions}
              packagesActive={packagesActive}
            />
          )
        }

        <!-- A div, not <main>: the page has its own main landmark. -->
        <div
          class="relative flex min-w-0 flex-1 flex-col overflow-hidden border-l-[0.5px] border-foreground/27 bg-background"
        >
          {
            page ? (
              <div class="h-11 shrink-0" />
            ) : (
              <SessionToolbar
                title={title}
                tab={tab}
                running={running}
                terminalOpen={terminalOpen}
                viewMode={viewMode}
                viewMenuOpen={viewMenuOpen}
                rightSidebarOpen={rightSidebarOpen}
              />
            )
          }

          <div class="relative min-h-0 flex-1 overflow-hidden">
            <!-- `bottom` is the terminal's height so the transcript ends above the panel, not under it. -->
            <div class="absolute inset-x-0 top-0 flex flex-col" style={chatStyle}>
              <div class="flex min-h-0 flex-1 flex-col">
                <slot />
              </div>
              {
                chatColumn && (
                  <ChatInput text={composerText} running={running}>
                    {slashMenuOpen && <SlashMenu slot="menu" />}
                  </ChatInput>
                )
              }
            </div>

            {
              terminalOpen && (
                <div
                  class="absolute inset-x-0 bottom-0 border-t-[0.5px] border-foreground/25"
                  style={`height:${TERMINAL_DEFAULT_HEIGHT}px`}
                >
                  <slot name="panel" />
                </div>
              )
            }
          </div>

          {overlayOpen && <div class="absolute inset-0 z-20 bg-black/20" aria-hidden="true" />}
          <slot name="overlay" />
        </div>

        {
          rightSidebarOpen && (
            <div
              class="flex h-full shrink-0 border-l-[0.5px] border-foreground/27 bg-background"
              style={`width:${RIGHT_SIDEBAR_DEFAULT_WIDTH}px`}
            >
              <slot name="right" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>
