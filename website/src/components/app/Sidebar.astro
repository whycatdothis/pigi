---
import Icon from '../Icon.astro';
import { SIDEBAR_DEFAULT_WIDTH } from '../../lib/appLayout';

interface SessionRow {
  title: string;
  time: string;
  /** This is the session the window has open. */
  active?: boolean;
}

interface Project {
  name: string;
  sessions?: SessionRow[];
}

/**
 * The project list the windows show.
 *
 * A developer's own machine is what the app's screenshots show, so this is
 * authored rather than discovered — but the sessions are the ones this site is
 * about, and `activeTitle` selects the row that matches the window's open
 * session, the way the app's sidebar tracks the active session.
 */
const projects: Project[] = [
  {
    name: 'pigi',
    sessions: [
      { title: 'Fix the tree header overlap', time: '4m' },
      { title: 'Terminal panel resize jank', time: '18m' },
      { title: 'Add the chat minimap', time: '1h' },
      { title: 'The transcript flickers', time: '2h' },
      { title: 'Keep the session tree from blanking', time: 'Yesterday' },
      { title: 'Fork from message 12', time: 'Mon' },
      { title: 'Bump electron-builder', time: 'Mon' },
    ],
  },
  { name: 'pi-extension' },
  { name: 'test-playground' },
  { name: 'docs-site' },
];

interface Props {
  /** The open session's title; the matching row is the selected one. */
  activeTitle?: string;
}

const { activeTitle } = Astro.props;
---

<aside
  class="hidden shrink-0 flex-col bg-[var(--sidebar-solid)] sm:flex"
  style={`width:${SIDEBAR_DEFAULT_WIDTH}px`}
>
  <!-- Room for the traffic lights, which the window paints over this column. -->
  <div class="h-11 shrink-0"></div>

  <div class="flex flex-col gap-0.5 px-2">
    <div class="flex h-8 items-center gap-2 rounded-md px-2 text-sm text-sidebar-foreground/85">
      <Icon name="plus" size={16} class="text-muted-foreground" />
      <span>New chat</span>
    </div>
    <div class="flex h-8 items-center gap-2 rounded-md px-2 text-sm text-sidebar-foreground/85">
      <Icon name="folder-plus" size={16} class="text-muted-foreground" />
      <span>Open project</span>
    </div>
  </div>

  <div class="mt-4 flex min-h-0 flex-1 flex-col gap-0.5 overflow-hidden px-2">
    <p class="px-2 pb-1 text-xs text-sidebar-foreground/55">Projects</p>
    {
      projects.map((project) => (
        <>
          <div class="flex h-8 items-center gap-2 rounded-md px-2 text-sm text-sidebar-foreground/85">
            <Icon name="chevron-right" size={14} class="shrink-0 text-muted-foreground/70" />
            <Icon name="folder" size={15} class="shrink-0 text-muted-foreground" />
            <span class="truncate">{project.name}</span>
          </div>
          {project.sessions?.map((session) => {
            const active = session.title === activeTitle;
            return (
              <div
                data-sidebar-row={session.title}
                class:list={[
                  'flex h-8 items-center gap-2 rounded-md pr-2 text-sm',
                  active
                    ? 'bg-[var(--system-accent)]/10 pl-8 text-foreground'
                    : 'pl-8 text-sidebar-foreground/85',
                ]}
              >
                <span class="truncate">{session.title}</span>
                <span class="ml-auto shrink-0 text-xs text-muted-foreground tabular-nums">
                  {session.time}
                </span>
              </div>
            );
          })}
        </>
      ))
    }
  </div>

  <div class="px-2 pb-2">
    <div class="flex h-8 items-center gap-2 rounded-md px-2 text-sm text-sidebar-foreground/85">
      <Icon name="settings" size={16} class="text-muted-foreground" />
      <span>Settings</span>
    </div>
  </div>
</aside>
