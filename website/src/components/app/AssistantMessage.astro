---
import MessageActions from './MessageActions.astro';

interface Props {
  time?: string;
}

const { time } = Astro.props;
---

<div class="group flex justify-start">
  <div class="w-full min-w-0 text-[15px] text-foreground">
    <div class="markdown-body">
      <slot />
    </div>
    <MessageActions kind="full" time={time} />
  </div>
</div>
