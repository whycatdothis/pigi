---
import MessageActions, { type MessageActionTooltip } from './MessageActions.astro';

interface Props {
  time?: string;
  /** Keep the actions visible, for a still standing in for a hover. */
  showActions?: boolean;
  /** The label the app's tooltip would be showing for the action hovered. */
  actionTooltip?: MessageActionTooltip;
}

const { time, showActions = false, actionTooltip } = Astro.props;
---

<div class="group flex justify-start">
  <div class="w-full min-w-0 text-[15px] text-foreground">
    <div class="markdown-body">
      <slot />
    </div>
    <MessageActions kind="full" time={time} visible={showActions} tooltip={actionTooltip} />
  </div>
</div>
