---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import FeatureTour from '../components/site/FeatureTour.astro';
import DownloadButton from '../components/site/DownloadButton.astro';
import AppWindow from '../components/app/AppWindow.astro';
import Transcript from '../components/demos/Transcript.astro';
import { heroTurns } from '../lib/sessions';

/*
 * The title and the description carry the phrases someone types when they are
 * looking for this: "pi agent", "pi agent GUI", "pi GUI". The name alone ranks for
 * nothing, because "pigi" is not a search — the category is.
 */
const title = 'pigi — a pi agent GUI for macOS';
const description =
  'A sleek pi GUI for macOS: a desktop window on the pi coding agent, with instant session switching, forking, a session tree and a terminal — on the pi config and sessions already on your machine.';

const principles = [
  {
    icon: 'git-fork' as const,
    title: 'The same agent',
    body: 'pigi runs the pi agent library itself, in a process beside the window. Every tool pi supports, pigi supports.',
  },
  {
    icon: 'settings' as const,
    title: 'Your config',
    body: 'Models, skills and AGENTS.md come from the pi setup already on the machine. Nothing to describe twice.',
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <!--
      Hero.

      `-mt-14 pt-14` is the header's height, cancelled: the section starts under the
      header and pushes its own content back down, so the wash and the grid drawn
      inside it begin at the top of the page rather than at the header's bottom edge.
      Its masks are strongest at their centre, which would otherwise draw a soft but
      straight step across the page right where the header ends — the line the header
      no longer has. The header is transparent at rest, so the wash runs behind it.
    -->
    <section class="relative -mt-14 overflow-hidden pt-14">
      <div class="hero-grid pointer-events-none absolute inset-x-0 top-0 h-[720px]"></div>
      <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[720px]"></div>

      <div class="relative mx-auto max-w-[1248px] px-6 pb-16 pt-16 md:pt-24">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="text-[38px] font-semibold leading-[1.08] tracking-[-0.02em] text-foreground md:text-[54px]"
          >
            A sleek GUI for pi
          </h1>
          <!--
            The page's own action, under the name it is about. The header keeps a
            compact one for a reader who has scrolled away from here; both resolve
            to the same DMG through `initDownload`.
          -->
          <div class="mt-8 flex justify-center">
            <DownloadButton variant="hero" />
          </div>
        </div>

        <div class="mt-14">
          <AppWindow title="Fix the tree header overlap">
            <Transcript turns={heroTurns} />
          </AppWindow>
        </div>
      </div>
    </section>

    <FeatureTour />

    <!-- What it is built on -->
    <section class="border-t border-border/70 py-20 md:py-28">
      <div class="mx-auto grid max-w-[1248px] gap-10 px-6 md:grid-cols-2">
        {
          principles.map((principle) => (
            <div>
              <Icon name={principle.icon} size={20} class="text-[var(--system-accent)]" />
              <h3 class="mt-4 text-[15px] font-medium text-foreground">{principle.title}</h3>
              <p class="mt-2 text-[14px] leading-6 text-muted-foreground">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
