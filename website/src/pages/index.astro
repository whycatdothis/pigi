---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import FeatureTour from '../components/site/FeatureTour.astro';
import DownloadButton from '../components/site/DownloadButton.astro';
import AppWindow from '../components/app/AppWindow.astro';
import Transcript from '../components/demos/Transcript.astro';
import { heroTurns } from '../lib/sessions';

// Carry the search phrases ("pi agent GUI", "pi GUI"); "pigi" alone ranks for nothing.
const title = 'pigi — a pi agent GUI for macOS';
const description =
  'A sleek pi GUI for macOS: a desktop window on the pi coding agent, with instant session switching, forking, a session tree, files, git, quotes, subagents, packages and themes — on the pi config and sessions already on your machine.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <!-- `-mt-14 pt-14` (the header's height) starts the backdrop behind the
      transparent header; otherwise its masks draw a step where the header ends. -->
    <section class="relative -mt-14 overflow-hidden pt-14">
      <div class="hero-grid pointer-events-none absolute inset-x-0 top-0 h-[720px]"></div>
      <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[720px]"></div>

      <div class="relative mx-auto max-w-[1248px] px-6 pb-16 pt-16 md:pt-24">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="text-[38px] font-semibold leading-[1.08] tracking-[-0.02em] text-foreground md:text-[54px]"
          >
            A sleek GUI for pi
          </h1>
          <div class="mt-8 flex justify-center">
            <DownloadButton />
          </div>
        </div>

        <div class="mt-14">
          <AppWindow title="Fix the tree header overlap">
            <Transcript turns={heroTurns} />
          </AppWindow>
        </div>
      </div>
    </section>

    <FeatureTour />
  </main>

  <Footer />
</BaseLayout>
