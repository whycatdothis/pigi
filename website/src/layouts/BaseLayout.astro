---
import '../styles/global.css';
import { DOWNLOAD_URL, LICENSE_URL, UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../lib/site';
import { defaultThemeCss } from '../lib/appTheme';

interface Props {
  title: string;
  description: string;
  // For 404: it answers every unknown path, so no canonical and no indexing.
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Keeps localhost, previews and forks out of the stats. Umami matches the exact
// hostname, hence the www alias.
const siteHost = new URL(canonical).hostname;
const analyticsDomains = `${siteHost},www.${siteHost}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-256.png" />
    <meta name="theme-color" content="#fcf3f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16070d" media="(prefers-color-scheme: dark)" />

    <style is:inline set:html={defaultThemeCss()}></style>

    <!-- Blocking and inline so dark mode does not flash white. Same `theme` key
      and values as the app's themeProvider. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>

    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/icon-256.png', Astro.site).href} />
    <meta name="twitter:card" content="summary" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'pigi',
        alternateName: ['pi agent GUI', 'pi GUI', 'pigi — pi agent GUI', 'pigi GUI for pi'],
        applicationCategory: 'DeveloperApplication',
        applicationSubCategory: 'AI coding agent GUI',
        operatingSystem: 'macOS',
        processorRequirements: 'Apple Silicon',
        description,
        url: canonical,
        downloadUrl: DOWNLOAD_URL,
        license: LICENSE_URL,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        isAccessibleForFree: true,
      })}
    />

    <script
      defer
      src={UMAMI_SCRIPT_URL}
      data-website-id={UMAMI_WEBSITE_ID}
      data-domains={analyticsDomains}></script>
  </head>
  <body>
    <slot />

    <!-- On every page (the header and theme toggle need it); each initializer
      no-ops when its markup is absent. -->
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
