{
  "name": "pigi-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site for pigi, deployed to Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/checkAppClassDrift.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && node scripts/checkAppClassDrift.mjs && prettier --check .",
    "check:drift": "node scripts/checkAppClassDrift.mjs",
    "shots": "node scripts/shoot.mjs",
    "verify": "node scripts/verify-interactions.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tabler/icons": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "astro": "^7.4.13",
    "lucide-static": "^1.79.0",
    "material-icon-theme": "^5.40.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
